<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="https://github.com/avaloniaui/Markup/development-tools"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:oChan"
        mc:Ignorable="d"
        x:Class="oChan.SettingsWindow"
        x:DataType="local:SettingsWindow"
        Title="Settings"
        Width="470"
        Height="460"
        MinWidth="430"
        MinHeight="420">
    <ScrollViewer>
        <StackPanel Margin="20" Spacing="12">
            <TextBlock Text="Settings" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
            <StackPanel Spacing="12" IsEnabled="{Binding !IsBusy}">
                <TextBlock Text="Download path:"/>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Text="{Binding DownloadPath, Mode=TwoWay}"/>
                    <Button Grid.Column="1" Content="Browse" Margin="10,0,0,0" Click="OnBrowseButtonClick"/>
                </Grid>
                <TextBlock Text="Path changes apply to newly added threads." FontSize="12" TextWrapping="Wrap"/>

                <Grid ColumnDefinitions="*,110">
                    <TextBlock Text="Recheck timer (seconds):" VerticalAlignment="Center"/>
                    <NumericUpDown x:Name="RecheckTimerInput" Grid.Column="1" Value="{Binding RecheckTimer, Mode=TwoWay}" Minimum="10" Maximum="4294967" Increment="1"/>
                </Grid>

                <Grid ColumnDefinitions="*,110">
                    <TextBlock Text="Bandwidth limit (MiB/s):" VerticalAlignment="Center"/>
                    <NumericUpDown x:Name="BandwidthInput" Grid.Column="1" Value="{Binding BandwidthLimiterMB, Mode=TwoWay}" Minimum="0" Increment="0.1"/>
                </Grid>

                <Grid ColumnDefinitions="*,110">
                    <TextBlock Text="Parallel downloads:" VerticalAlignment="Center"/>
                    <NumericUpDown x:Name="ParallelDownloadsInput" Grid.Column="1" Value="{Binding MaxParallelDownloads, Mode=TwoWay}" Minimum="1" Maximum="2147483647" Increment="1"/>
                </Grid>

                <CheckBox Content="Restore session on startup" IsChecked="{Binding SaveUrlsOnExit, Mode=TwoWay}"/>
                <CheckBox Content="Minimize to tray" IsChecked="{Binding MinimizeToTray, Mode=TwoWay}"/>
                <Button Content="Save &amp; Close" HorizontalAlignment="Center" Click="OnCloseButtonClick"/>
            </StackPanel>
            <TextBlock x:Name="SettingsError" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextWrapping="Wrap" Foreground="Crimson"/>
        </StackPanel>
    </ScrollViewer>
</Window>
