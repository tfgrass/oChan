<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="oChan.MainWindow"
        xmlns:local="clr-namespace:oChan"
        xmlns:desktop="clr-namespace:oChan.Desktop"
        x:DataType="local:MainWindow"
        Width="1100" Height="600" MinWidth="800"
        Title="oChan"
        Icon="avares://oChan/Assets/ochan.png">
    <DockPanel>
        <!-- Application Menu -->
        <Menu DockPanel.Dock="Top">
            <MenuItem x:Name="SettingsMenuItem" Header="_Settings" />
            <MenuItem x:Name="AboutMenuItem" Header="_About" />
            <MenuItem x:Name="ExitMenuItem" Header="E_xit" />
        </Menu>

        <!-- Main Content -->
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <!-- Row for URL Input Section -->
                <RowDefinition Height="Auto" />
                <!-- Row for TabControl (Threads and Boards) -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- URL Input Section -->
            <Grid Grid.Row="0" Margin="8,0,8,0">
                <Grid.ColumnDefinitions>
                    <!-- TextBox will take up remaining space -->
                    <ColumnDefinition Width="*" />
                    <!-- Button will have a fixed width -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="UrlInput" Grid.Column="0" Watermark="Enter Thread or Board URL here ..." />
                <Button x:Name="AddUrlButton" Grid.Column="1" Content="Add" Margin="10,0,0,0" Width="100" Click="OnAddUrl"/>
            </Grid>

            <!-- Tabs for Threads and Boards -->
            <TabControl Grid.Row="1" Margin="0,10,0,0">
                <!-- Threads Tab -->
                <TabItem Header="Threads">
                    <!-- DataGrid for displaying Thread URL, Progress, and Status -->
                    <DataGrid x:Name="ThreadsDataGrid"
                              ItemsSource="{Binding UrlList}"
                              AutoGenerateColumns="False"
                              GridLinesVisibility="All"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              DoubleTapped="OnThreadDoubleTapped"
                              CanUserResizeColumns="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Host" Width="80" SortMemberPath="HostName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="desktop:ThreadRow">
                                        <TextBlock Text="{Binding HostName}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Board" Width="100" SortMemberPath="BoardName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="desktop:ThreadRow">
                                        <TextBlock Text="{Binding BoardName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding BoardName}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Thread ID Column -->
                            <DataGridTemplateColumn Header="Thread ID" Width="90" SortMemberPath="ThreadNumber">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="desktop:ThreadRow">
                                        <TextBlock Text="{Binding ThreadId}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Title Column -->
                            <DataGridTemplateColumn Header="Title" Width="*" MinWidth="120" SortMemberPath="Title">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="desktop:ThreadRow">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Status Column -->
                            <DataGridTemplateColumn Header="Status" Width="250" SortMemberPath="Status">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="desktop:ThreadRow">
                                        <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusDetails}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Progress Column -->
                            <DataGridTemplateColumn Header="Progress" Width="140" SortMemberPath="Completion">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="desktop:ThreadRow">
                                        <TextBlock Text="{Binding Progress}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Queued" Width="85" SortMemberPath="Queued">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="desktop:ThreadRow">
                                        <TextBlock Text="{Binding Queued}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Active" Width="80" SortMemberPath="Active">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="desktop:ThreadRow">
                                        <TextBlock Text="{Binding Active}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>

                        <!-- ContextMenu for right-clicking on a row -->
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open Directory" Click="OnOpenThreadDirectoryClick">
                                    <MenuItem.Icon>
                                        <Image Source="avares://oChan/Assets/icons/folder.png" Width="16" Height="16"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Open in Browser" Click="OnOpenThreadInBrowserClick">
                                    <MenuItem.Icon>
                                        <Image Source="avares://oChan/Assets/icons/external-link.png" Width="16" Height="16"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Remove" Click="OnRemoveThreadMenuItemClick">
                                    <MenuItem.Icon>
                                        <Image Source="avares://oChan/Assets/icons/delete.png" Width="16" Height="16"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                </TabItem>

                <!-- Boards Tab -->
                <TabItem Header="Boards">
                    <!-- DataGrid for displaying Board URLs -->
                    <DataGrid x:Name="BoardsDataGrid"
                              ItemsSource="{Binding BoardsList}"
                              AutoGenerateColumns="False"
                              GridLinesVisibility="All"
                              CanUserSortColumns="True"
                              HeadersVisibility="All"
                              DoubleTapped="OnBoardDoubleTapped"
                              CanUserResizeColumns="True">
                        <DataGrid.Columns>
                            <!-- Board URL Column -->
                            <DataGridTemplateColumn Header="Host" Width="100" SortMemberPath="HostName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="desktop:BoardRow">
                                        <TextBlock Text="{Binding HostName}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Board" Width="200" SortMemberPath="NiceName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="desktop:BoardRow">
                                        <TextBlock Text="{Binding NiceName}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Status" Width="*" SortMemberPath="Status">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="desktop:BoardRow">
                                        <TextBlock Text="{Binding Status}" ToolTip.Tip="{Binding ErrorDetails}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>

                        <!-- ContextMenu for right-clicking on a row -->
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open Directory" Click="OnOpenBoardDirectoryClick">
                                    <MenuItem.Icon>
                                        <Image Source="avares://oChan/Assets/icons/folder.png" Width="16" Height="16"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Open in Browser" Click="OnOpenBoardInBrowserClick">
                                    <MenuItem.Icon>
                                        <Image Source="avares://oChan/Assets/icons/external-link.png" Width="16" Height="16"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Remove" Click="OnRemoveBoardMenuItemClick">
                                    <MenuItem.Icon>
                                        <Image Source="avares://oChan/Assets/icons/delete.png" Width="16" Height="16"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
